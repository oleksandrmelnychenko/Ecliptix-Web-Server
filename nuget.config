<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github-ecliptix" value="https://nuget.pkg.github.com/oleksandrmelnychenko/index.json" />
    <add key="local" value="/Users/oleksandrmelnychenko/.nuget/local-packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github-ecliptix">
      <package pattern="EPP.*" />
      <package pattern="Ecliptix.*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="Ecliptix.OPAQUE.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <RootNamespace>Ecliptix.Protobuf</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Transport proto files -->
    <Protobuf Include="Protobuf\transport\common\event_envelope.proto" GrpcServices="None" ProtoRoot="Protobuf" AdditionalImportDirs="Protobuf" />
    <Protobuf Include="Protobuf\transport\gateway\event_gateway.proto" GrpcServices="Server" ProtoRoot="Protobuf" AdditionalImportDirs="Protobuf" />
    <Protobuf Include="Protobuf\transport\device_provisioning\session.proto" GrpcServices="None" ProtoRoot="Protobuf" AdditionalImportDirs="Protobuf" />

    <!-- Common proto files -->
    <Protobuf Include="Protobuf\common\health_check.proto" GrpcServices="Server" ProtoRoot="Protobuf" AdditionalImportDirs="Protobuf" />

    <!-- Identity Access context proto files -->
    <Protobuf Include="Protobuf\contexts\identity_access\membership.proto" GrpcServices="None" ProtoRoot="Protobuf" AdditionalImportDirs="Protobuf" />
    <Protobuf Include="Protobuf\contexts\identity_access\account.proto" GrpcServices="None" ProtoRoot="Protobuf" AdditionalImportDirs="Protobuf" />
    <Protobuf Include="Protobuf\contexts\identity_access\opaque.proto" GrpcServices="None" ProtoRoot="Protobuf" AdditionalImportDirs="Protobuf" />
    <Protobuf Include="Protobuf\contexts\identity_access\verification.proto" GrpcServices="None" ProtoRoot="Protobuf" AdditionalImportDirs="Protobuf" />

    <!-- Device Provisioning context proto files -->
    <Protobuf Include="Protobuf\contexts\device_provisioning\device.proto" GrpcServices="None" ProtoRoot="Protobuf" AdditionalImportDirs="Protobuf" />

    <!-- Secure Protocol context proto files -->
    <Protobuf Include="Protobuf\contexts\secure_protocol\key_exchange.proto" GrpcServices="None" ProtoRoot="Protobuf" AdditionalImportDirs="Protobuf" />
    <Protobuf Include="Protobuf\contexts\secure_protocol\session_state.proto" GrpcServices="None" ProtoRoot="Protobuf" AdditionalImportDirs="Protobuf" />

    <!-- Protocol core proto files -->
    <Protobuf Include="Protobuf\protocol\envelope.proto" GrpcServices="None" ProtoRoot="Protobuf" AdditionalImportDirs="Protobuf" />
    <Protobuf Include="Protobuf\protocol\error.proto" GrpcServices="None" ProtoRoot="Protobuf" AdditionalImportDirs="Protobuf" />
    <Protobuf Include="Protobuf\protocol\handshake.proto" GrpcServices="None" ProtoRoot="Protobuf" AdditionalImportDirs="Protobuf" />
    <Protobuf Include="Protobuf\protocol\state.proto" GrpcServices="None" ProtoRoot="Protobuf" AdditionalImportDirs="Protobuf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.33.2" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <EnableRequestGrpcPrecompile>true</EnableRequestGrpcPrecompile>
  </PropertyGroup>

</Project>

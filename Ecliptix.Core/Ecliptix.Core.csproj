
<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64</RuntimeIdentifiers>
        <LangVersion>14</LangVersion>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)'==''">$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</RuntimeIdentifier>
    </PropertyGroup>

    <ItemGroup>
        <!-- Security overrides for transitive dependencies -->
        <PackageReference Include="Azure.Identity" />
        <PackageReference Include="Microsoft.Identity.Client" />

        <PackageReference Include="Akka" />
        <PackageReference Include="Akka.Cluster" />
        <PackageReference Include="Akka.Cluster.Hosting" />
        <PackageReference Include="Akka.Cluster.Metrics" />
        <PackageReference Include="Akka.Cluster.Sharding" />
        <PackageReference Include="Akka.Cluster.Tools" />
        <PackageReference Include="Akka.DependencyInjection" />
        <PackageReference Include="Akka.Discovery" />
        <PackageReference Include="Akka.Discovery.KubernetesApi" />
        <PackageReference Include="Akka.Hosting" />
        <PackageReference Include="Akka.Management" />
        <PackageReference Include="Akka.Persistence" />
        <PackageReference Include="Akka.Persistence.Hosting" />
        <PackageReference Include="Akka.Persistence.Sql" />
        <PackageReference Include="Akka.Persistence.Sql.Hosting" />
        <PackageReference Include="Akka.Remote" />
        <PackageReference Include="Dapper" />
        <PackageReference Include="dbup" />
        <PackageReference Include="Grpc.AspNetCore.Server" />
        <PackageReference Include="Grpc.Core.Api" />
        <PackageReference Include="Grpc.Net.Common" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="OpenTelemetry" />
        <PackageReference Include="OpenTelemetry.Exporter.Console" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
        <PackageReference Include="protobuf-net" />
        <PackageReference Include="Serilog.Sinks.ApplicationInsights" />
        <PackageReference Include="Sodium.Core" />
        <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
        <PackageReference Include="EPP.Relay" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\.dockerignore">
          <Link>.dockerignore</Link>
        </Content>
        <Content Include="server_private.pem">
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
    <ProjectReference Include="..\Ecliptix.Security.Certificate.Pinning\Ecliptix.Security.Certificate.Pinning.csproj" />
        <ProjectReference Include="..\Ecliptix.Security.Opaque\Ecliptix.Security.Opaque.csproj" />
    <ProjectReference Include="..\Ecliptix.Protobufs\Ecliptix.Protobufs.csproj" />
        <ProjectReference Include="..\src\Shared\Ecliptix.SharedKernel\Ecliptix.SharedKernel.csproj" />
        <ProjectReference Include="..\src\Contexts\IdentityAccess\Domain\Ecliptix.IdentityAccess.Domain.csproj" />
    <ProjectReference Include="..\src\Contexts\IdentityAccess\Infrastructure\Ecliptix.IdentityAccess.Infrastructure.csproj" />
    <ProjectReference Include="..\src\Contexts\DeviceProvisioning\Domain\Ecliptix.DeviceProvisioning.Domain.csproj" />
        <ProjectReference Include="..\src\Contexts\DeviceProvisioning\Infrastructure\Ecliptix.DeviceProvisioning.Infrastructure.csproj" />
        <ProjectReference Include="..\src\Contexts\SecureProtocol\Domain\Ecliptix.SecureProtocol.Domain.csproj" />
        <ProjectReference Include="..\src\Contexts\SecureProtocol\Infrastructure\Ecliptix.SecureProtocol.Infrastructure.csproj" />
        <ProjectReference Include="..\src\Tools\Ecliptix.EventRouting.Generator\Ecliptix.EventRouting.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="logs\" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Configuration\AkkaConfiguration_Draft.cs" />
      <Compile Remove="Domain\Protocol\**\*.cs" />
      <Compile Remove="Domain\ProtocolNative\**\*.cs" />
    </ItemGroup>
</Project>


<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64</RuntimeIdentifiers>
        <LangVersion>14</LangVersion>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)'==''">$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</RuntimeIdentifier>
    </PropertyGroup>

    <ItemGroup>
        <!-- Security overrides for transitive dependencies -->
        <PackageReference Include="Azure.Identity" Version="1.13.2" />
        <PackageReference Include="Microsoft.Identity.Client" Version="4.67.2" />

        <PackageReference Include="Akka" Version="1.5.57" />
        <PackageReference Include="Akka.Cluster" Version="1.5.57" />
        <PackageReference Include="Akka.Cluster.Hosting" Version="1.5.57" />
        <PackageReference Include="Akka.Cluster.Metrics" Version="1.5.57" />
        <PackageReference Include="Akka.Cluster.Sharding" Version="1.5.57" />
        <PackageReference Include="Akka.Cluster.Tools" Version="1.5.57" />
        <PackageReference Include="Akka.DependencyInjection" Version="1.5.57" />
        <PackageReference Include="Akka.Discovery" Version="1.5.57" />
        <PackageReference Include="Akka.Discovery.KubernetesApi" Version="1.5.57" />
        <PackageReference Include="Akka.Hosting" Version="1.5.57" />
        <PackageReference Include="Akka.Management" Version="1.5.57" />
        <PackageReference Include="Akka.Persistence" Version="1.5.57" />
        <PackageReference Include="Akka.Persistence.Hosting" Version="1.5.57" />
        <PackageReference Include="Akka.Persistence.Sql" Version="1.5.55.1" />
        <PackageReference Include="Akka.Persistence.Sql.Hosting" Version="1.5.55.1" />
        <PackageReference Include="Akka.Remote" Version="1.5.57" />
        <PackageReference Include="Dapper" Version="2.1.66" />
        <PackageReference Include="dbup" Version="5.0.41" />
        <PackageReference Include="Grpc.AspNetCore.Server" Version="2.76.0" />
        <PackageReference Include="Grpc.Core.Api" Version="2.76.0" />
        <PackageReference Include="Grpc.Net.Common" Version="2.76.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="OpenTelemetry" Version="1.14.0" />
        <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.14.0" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.14.0" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.14.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.14.0" />
        <PackageReference Include="protobuf-net" Version="3.2.56" />
        <PackageReference Include="Serilog.Sinks.ApplicationInsights" Version="4.1.0" />
        <PackageReference Include="Sodium.Core" Version="1.4.0" />
        <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
        <PackageReference Include="EPP.Relay" Version="1.0.1" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\.dockerignore">
          <Link>.dockerignore</Link>
        </Content>
        <Content Include="server_private.pem">
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
    <ProjectReference Include="..\Ecliptix.Security.Certificate.Pinning\Ecliptix.Security.Certificate.Pinning.csproj" />
        <ProjectReference Include="..\Ecliptix.Security.Opaque\Ecliptix.Security.Opaque.csproj" />
    <ProjectReference Include="..\Ecliptix.Protobufs\Ecliptix.Protobufs.csproj" />
        <ProjectReference Include="..\src\Shared\Ecliptix.SharedKernel\Ecliptix.SharedKernel.csproj" />
        <ProjectReference Include="..\src\Contexts\IdentityAccess\Domain\Ecliptix.IdentityAccess.Domain.csproj" />
    <ProjectReference Include="..\src\Contexts\IdentityAccess\Infrastructure\Ecliptix.IdentityAccess.Infrastructure.csproj" />
    <ProjectReference Include="..\src\Contexts\DeviceProvisioning\Domain\Ecliptix.DeviceProvisioning.Domain.csproj" />
        <ProjectReference Include="..\src\Contexts\DeviceProvisioning\Infrastructure\Ecliptix.DeviceProvisioning.Infrastructure.csproj" />
        <ProjectReference Include="..\src\Contexts\SecureProtocol\Domain\Ecliptix.SecureProtocol.Domain.csproj" />
        <ProjectReference Include="..\src\Contexts\SecureProtocol\Infrastructure\Ecliptix.SecureProtocol.Infrastructure.csproj" />
        <ProjectReference Include="..\src\Tools\Ecliptix.EventRouting.Generator\Ecliptix.EventRouting.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="logs\" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Configuration\AkkaConfiguration_Draft.cs" />
      <Compile Remove="Domain\Protocol\**\*.cs" />
      <Compile Remove="Domain\ProtocolNative\**\*.cs" />
    </ItemGroup>
</Project>
